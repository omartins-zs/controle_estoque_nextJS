APP_NAME="Controle de Estoque Next.js"
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
NEXT_TELEMETRY_DISABLED=1

# LOCAL
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
HOSTNAME=0.0.0.0

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=controle_estoque
DB_USERNAME=root
DB_PASSWORD=

